{
  "name": "codebase-engine-api",
  "version": "1.0.0",
  "description": "Node.js REST API layer for the AI Codebase Understanding Engine",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "bullmq": "^5.7.8",
    "ioredis": "^5.4.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "archiver": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "adm-zip": "^0.5.14",
    "glob": "^11.0.0",
    "morgan": "^1.10.0",
    "winston": "^3.13.0",
    "joi": "^17.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@jest/globals": "^29.7.0",
    "eslint": "^9.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}