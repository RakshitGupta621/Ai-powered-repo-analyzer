# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here     # Get free at aistudio.google.com
INTERNAL_API_KEY=change-me-to-a-long-random-secret  # Must match backend-api

# ── Embedding provider ────────────────────────────────────────────────────────
# Leave blank to auto-detect (tries Ollama first, then HuggingFace)
# Options: ollama | huggingface | gemini
EMBEDDING_PROVIDER=ollama

# ── HuggingFace (only needed if EMBEDDING_PROVIDER=huggingface) ───────────────
# Free at huggingface.co — leave blank to use without token (rate-limited)
HF_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────
ENV=development
CHROMA_PATH=./chroma_data
TOP_K_RESULTS=8
MAX_CHUNK_TOKENS=400
GEMINI_LLM_MODEL=gemini-2.5-flash
